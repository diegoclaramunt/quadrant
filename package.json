{
  "name": "quadrant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "serve:web": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx serve web",
    "serve:api": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx serve api",
    "serve:mcp": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx serve mcp",
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t build --projects=web,api,mcp",
    "build:web": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build web",
    "build:api": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build api",
    "build:mcp": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build mcp",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t test --projects=domain,application,storage,capabilities,api,mcp,web",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t lint --projects=domain,application,storage,capabilities,api,mcp,web",
    "graph": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx graph",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t typecheck --projects=domain,application,storage,capabilities,api,mcp,web",
    "generate:types": "node tools/generate-types.mjs",
    "generate:schemas": "node tools/emit-schemas.mjs",
    "postinstall": "cd node_modules/better-sqlite3 && npx --yes prebuild-install || true"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "22.6.5",
    "@nx/esbuild": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/nest": "22.6.5",
    "@nx/node": "22.6.5",
    "@nx/web": "22.6.5",
    "@nx/webpack": "22.6.5",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~21.2.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsdom": "^27.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "nx": "22.6.5",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8",
    "webpack-cli": "^5.1.4"
  },
  "nx": {}
}
