{
  "$id": "https://quadrant.local/schemas/week.open.output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["week"],
  "properties": {
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weekStart", "status", "slots", "blocks"],
      "properties": {
        "id": {
          "type": ["string", "null"]
        },
        "weekStart": {
          "type": ["string", "null"]
        },
        "status": {
          "type": ["string", "null"]
        },
        "templateId": {
          "type": ["string", "null"]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/slot"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/block"
          }
        },
        "resumedTaskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "today": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string"
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalMinutes",
            "occupiedMinutes",
            "freeMinutes",
            "days"
          ],
          "properties": {
            "totalMinutes": {
              "type": "integer"
            },
            "occupiedMinutes": {
              "type": "integer"
            },
            "freeMinutes": {
              "type": "integer"
            },
            "days": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "weekday",
                  "totalMinutes",
                  "occupiedMinutes",
                  "freeMinutes"
                ],
                "properties": {
                  "weekday": {
                    "type": "integer"
                  },
                  "totalMinutes": {
                    "type": "integer"
                  },
                  "occupiedMinutes": {
                    "type": "integer"
                  },
                  "freeMinutes": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
