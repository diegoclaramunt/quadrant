{
  "$id": "https://quadrant.local/schemas/week.adjust_slots.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "request_id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "confirmation_token": {
      "$ref": "common.json#/$defs/confirmationToken"
    },
    "weekPlanId": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "remove", "move", "change"]
          },
          "slotId": {
            "type": "string"
          },
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "order": {
            "type": "integer"
          },
          "kind": {
            "$ref": "common.json#/$defs/slotKind"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "startTime": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
