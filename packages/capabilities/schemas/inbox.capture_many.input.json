{
  "$id": "https://quadrant.local/schemas/inbox.capture_many.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "request_id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "confirmation_token": {
      "$ref": "common.json#/$defs/confirmationToken"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel"],
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "originalText": {
            "type": "string"
          },
          "channel": {
            "$ref": "common.json#/$defs/channel"
          },
          "alreadyProcessed": {
            "type": "boolean"
          },
          "urgent": {
            "type": "boolean"
          },
          "important": {
            "type": "boolean"
          },
          "workType": {
            "$ref": "common.json#/$defs/workType"
          },
          "nominalMinutes": {
            "type": "integer"
          },
          "projectId": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "deadline": {
            "$ref": "common.json#/$defs/isoDate"
          }
        }
      }
    }
  }
}
