{
  "$id": "https://quadrant.local/schemas/plan.propose.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "weekPlanId": {
      "type": "string"
    },
    "reservations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "slotId"],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "slotId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
