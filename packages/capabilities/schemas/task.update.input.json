{
  "$id": "https://quadrant.local/schemas/task.update.input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId"],
  "properties": {
    "request_id": {
      "$ref": "common.json#/$defs/requestId"
    },
    "confirmation_token": {
      "$ref": "common.json#/$defs/confirmationToken"
    },
    "taskId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": ["string", "null"]
    },
    "urgent": {
      "type": "boolean"
    },
    "important": {
      "type": "boolean"
    },
    "workType": {
      "$ref": "common.json#/$defs/workType"
    },
    "nominalMinutes": {
      "type": ["integer", "null"]
    },
    "deadline": {
      "type": ["string", "null"]
    },
    "availableOn": {
      "type": ["string", "null"]
    },
    "projectId": {
      "type": ["string", "null"]
    },
    "categoryId": {
      "type": ["string", "null"]
    }
  }
}
